<footer class="site-foot">
  <div class="shell">
    <div class="site-foot__top">
      <a class="site-foot__mark" href="/">
        <span aria-hidden="true">A<span class="site-foot__dash"></span>XS</span>
        <span class="sr-only">A-XS — home</span>
      </a>
      <p class="site-foot__statement">
        Independent systems studio.<br />
        {{ site.location }} <span aria-hidden="true">·</span> {{ site.coordinates }}
      </p>
    </div>

    <div class="site-foot__grid">
      <div class="site-foot__col">
        <h2 class="foot-label">Index</h2>
        <ul>
          {% for item in site.nav %}
            <li><a href="{{ item.href }}">{{ item.label }}</a></li>
          {% endfor %}
          <li><a href="/colophon/">Colophon</a></li>
        </ul>
      </div>
      <div class="site-foot__col">
        <h2 class="foot-label">Elsewhere</h2>
        <ul>
          {% for social in site.socials %}
            <li><a href="{{ social.href }}" rel="{{ social.rel }} noopener" target="_blank">{{ social.label }} ↗</a></li>
          {% endfor %}
          {% if site.linkedin %}
            <li><a href="{{ site.linkedin }}" rel="me noopener" target="_blank">LinkedIn ↗</a></li>
          {% endif %}
          <li><a href="{{ site.repo }}" rel="noopener" target="_blank">Site source ↗</a></li>
        </ul>
      </div>
      <div class="site-foot__col">
        <h2 class="foot-label">Status</h2>
        <ul>
          <li>Private archive</li>
          <li>Open for correspondence</li>
          <li>No trackers</li>
          <li>No cookies</li>
        </ul>
      </div>
      <div class="site-foot__col site-foot__col--note">
        <h2 class="foot-label">Note</h2>
        <p>Selected work is held privately while it is being finished. Dossiers are shared by request.</p>
      </div>
    </div>

    <div class="site-foot__base">
      <span>© {{ site.year }} A-XS. All rights reserved.</span>
      <span class="site-foot__set">Set in Bodoni Moda, Newsreader &amp; IBM Plex Mono.</span>
      <a href="#top">Back to top ↑</a>
    </div>
  </div>
</footer>
