<!doctype html>
<html lang="en" data-theme="ink">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{% if page.url == "/" %}{{ site.title }}{% elif title %}{{ title }} — A-XS{% else %}{{ site.title }}{% endif %}</title>
    <meta name="description" content="{{ description or site.description }}" />
    <meta name="author" content="A-XS" />
    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" content="{{ site.themeColor }}" />
    <meta name="robots" content="{% if noindex %}noindex, nofollow{% else %}index, follow{% endif %}" />
    <link rel="canonical" href="{{ site.url }}{{ page.url }}" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="A-XS" />
    <meta property="og:title" content="{% if page.url == "/" %}{{ site.title }}{% elif title %}{{ title }} — A-XS{% else %}{{ site.title }}{% endif %}" />
    <meta property="og:description" content="{{ description or site.description }}" />
    <meta property="og:url" content="{{ site.url }}{{ page.url }}" />
    <meta property="og:image" content="{{ site.url }}{{ site.ogImage }}" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="A-XS — Independent systems studio" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="{% if page.url == "/" %}{{ site.title }}{% elif title %}{{ title }} — A-XS{% else %}{{ site.title }}{% endif %}" />
    <meta name="twitter:description" content="{{ description or site.description }}" />
    <meta name="twitter:image" content="{{ site.url }}{{ site.ogImage }}" />

    <link rel="icon" href="/assets/img/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/assets/img/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/assets/img/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <link rel="preload" href="/assets/fonts/bodoni-moda-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/assets/fonts/newsreader-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/assets/fonts/ibm-plex-mono-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="/assets/css/main.css" />

    <script>
      (function () {
        try {
          if (localStorage.getItem("axs-theme") === "paper") {
            document.documentElement.dataset.theme = "paper";
            var themeMeta = document.querySelector('meta[name="theme-color"]');
            if (themeMeta) themeMeta.setAttribute("content", "#efe8db");
          }
        } catch (error) {}
      })();
    </script>

    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "ProfessionalService",
        "name": "A-XS",
        "url": "{{ site.url }}",
        "description": "{{ site.description }}",
        "areaServed": "Worldwide",
        "address": {
          "@type": "PostalAddress",
          "addressCountry": "DZ"
        },
        "sameAs": ["{{ site.github }}"]
      }
    </script>
  </head>
  <body id="top" class="page page--{{ page.fileSlug }}">
    <a class="skip-link" href="#main">Skip to content</a>
    {% include "header.njk" %}
    <main id="main">{{ content | safe }}</main>
    {% include "footer.njk" %}
    <script src="/assets/js/main.js" defer></script>
  </body>
</html>
